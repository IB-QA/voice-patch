{
  "enabledMcpjsonServers": [
    "voicemode"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "converse|converse_continue|mcp__.*converse",
        "hooks": [
          {
            "type": "command",
            "command": "./voice_mode/data/hooks/converse-pre-tool-use.sh --client auto || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/scripts/voicemode-hook-receiver || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/scripts/voicemode-hook-receiver || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/scripts/voicemode-hook-receiver || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/scripts/voicemode-hook-receiver || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/scripts/voicemode-hook-receiver || true"
          }
        ]
      }
    ]
  }
}
